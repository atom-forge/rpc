{
	"name": "@atom-forge/rpc",
	"version": "0.3.16",
	"description": "Type-safe RPC framework for TypeScript with Zod validation and middleware support",
	"keywords": [
		"rpc",
		"typescript",
		"zod",
		"type-safe",
		"middleware",
		"api"
	],
	"author": {
		"name": "Gergely Laborci",
		"url": "https://github.com/laborci"
	},
	"license": "SEE LICENSE IN LICENSE",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"repository": {
		"url": "git://github.com/atom-forge/rpc.git"
	},
	"files": [
		"dist",
		"LICENSE",
		"CHANGELOG.md",
		"README.md",
		"docs"
	],
	"scripts": {
		"build": "tsc",
		"prepublishOnly": "bun run build",
		"release": "npm publish --access public",
		"pub-check": "bun run scripts/pub-check.ts",
		"pub": "bun run scripts/pub.ts"
	},
	"dependencies": {
		"msgpackr": "^1.11.8"
	},
	"peerDependencies": {
		"zod": ">=4.0.0"
	},
	"devDependencies": {
		"typescript": "^5.0.0",
		"@types/node": "^25.3.1",
		"zod": "^4.3.6"
	}
}
